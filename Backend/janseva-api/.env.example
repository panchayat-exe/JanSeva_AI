# ============================================================
# JanSeva AI — Environment Variables
# Copy this file to .env and fill in all values
# NEVER commit .env to version control
# ============================================================

# ── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_NAME=JanSeva AI
API_VERSION=v1
FRONTEND_URL=http://localhost:5173

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/janseva_db?schema=public

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ── JWT ─────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_64_chars_change_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_64_chars_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
EMAIL_FROM_NAME=JanSeva AI
EMAIL_FROM_ADDRESS=noreply@janseva.gov.in

# ── AI — Groq ────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.3

# ── File Upload ──────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,video/mp4

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ── Email Verification ───────────────────────────────────────
EMAIL_VERIFY_TOKEN_EXPIRES_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRES_HOURS=2

# ── Security ─────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=./logs
